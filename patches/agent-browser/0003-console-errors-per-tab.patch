+    /// Mutable lookup of the page whose CDP session_id matches `sid`. Returns
+    /// None if no page owns this session (e.g. cross-origin iframe session).
+    pub fn page_for_session_mut(&mut self, sid: &str) -> Option<&mut PageInfo> {
+        self.pages.iter_mut().find(|p| p.session_id == sid)
+    }
+
+    /// Mutable lookup of the page whose stable tab_id matches.
+    pub fn page_by_tab_id_mut(&mut self, tab_id: u32) -> Option<&mut PageInfo> {
+        self.pages.iter_mut().find(|p| p.tab_id == tab_id)
+    }
+
+    /// Mutable handle to the currently active page.
+    pub fn active_page_mut(&mut self) -> Option<&mut PageInfo> {
+        self.pages.get_mut(self.active_page_index)
+    }
