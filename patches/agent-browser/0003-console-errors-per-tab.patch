+/// Pick the page to operate on: explicit `tab_id` if given, otherwise the
+/// currently active page. Returns an error if neither resolves to a page.
+fn resolve_page_mut(
+    mgr: &mut BrowserManager,
+    tab_id: Option<u32>,
+) -> Result<&mut PageInfo, String> {
+    match tab_id {
+        Some(id) => mgr
+            .page_by_tab_id_mut(id)
+            .ok_or_else(|| format!("Unknown tab id: t{id}")),
+        None => mgr.active_page_mut().ok_or_else(|| "No active page".to_string()),
