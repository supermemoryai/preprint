+/// Parse an optional `--tab <id>` flag from a slice of argument tokens.
+/// Accepts bare numerals ("2") or t-prefixed ids ("t2"). Returns None if the
+/// flag is absent.
+fn parse_tab_flag(rest: &[&str], context: &str) -> Result<Option<u32>, ParseError> {
+    let Some(idx) = rest.iter().position(|s| *s == "--tab") else {
+        return Ok(None);
+    };
+    let raw = rest.get(idx + 1).ok_or_else(|| ParseError::MissingArguments {
+        context: context.to_string(),
+        usage: "expected <id> after --tab",
+    })?;
+    let trimmed = raw.strip_prefix('t').unwrap_or(raw);
+    let id: u32 = trimmed.parse().map_err(|_| ParseError::InvalidValue {
+        message: format!("invalid tab id: {raw}"),
+        usage: "--tab <number|tN>",
+    })?;
+    Ok(Some(id))
+}
